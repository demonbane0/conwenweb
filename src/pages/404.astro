---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../utils/url";
---

<Layout
  title="頁面不存在"
  description="找不到這個頁面，可能已移除或網址有誤。請回耕紋貿易首頁，或到產品介紹搜尋型號。"
  noindex
>
  <section class="section not-found">
    <div class="container">
      <h1>找不到頁面</h1>
      <p>此頁面可能已移除或網址有誤。</p>
      <a class="btn btn-accent" href={withBase("/")}>返回首頁</a>
    </div>
  </section>
</Layout>
